{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "fastapi",
      "runtimeExecutable": ".venv/Scripts/uvicorn.exe",
      "runtimeArgs": ["api.main:app", "--port", "8001", "--reload"],
      "port": 8001
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--port", "5174"],
      "port": 5174
    },
    {
      "name": "design",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "http.server", "8002"],
      "port": 8002
    }
  ]
}
